      },
      "spec": {
        "ipAddressPools": [
          "lab-reserved",
          "lab-vibestudio",
          "lab-home-dashboard"
        ],
        "interfaces": [
          "eno2",
          "enp2s0",
          "enp1s0"
        ]
      }
    }
  ]
