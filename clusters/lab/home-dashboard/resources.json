        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "homepage",
        "namespace": "lab-dashboard",
        "annotations": {
          "metallb.io/loadBalancerIPs": "192.168.1.16"
        }
      },
      "spec": {
        "type": "LoadBalancer",
        "allocateLoadBalancerNodePorts": false,
        "externalTrafficPolicy": "Local",
        "loadBalancerSourceRanges": [
          "192.168.1.109/32"
        ],
        "selector": {
          "app": "homepage"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "homepage-owner-access",
        "namespace": "lab-dashboard"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "homepage"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "ipBlock": {
                  "cidr": "192.168.1.109/32"
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "lab-dashboard"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "homepage"
