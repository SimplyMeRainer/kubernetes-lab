      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "plex",
        "namespace": "media"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "plex"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "plex"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "plex",
                "image": "lscr.io/linuxserver/plex@sha256:be083133dfe001b6caed5a321720e6db9d38fdde1ea8f9d29340d40057a7fa53",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 32400
                  }
                ],
                "env": [
                  {
                    "name": "PUID",
                    "value": "1000"
                  },
                  {
                    "name": "PGID",
                    "value": "1000"
                  },
                  {
                    "name": "TZ",
                    "value": "America/New_York"
                  },
                  {
                    "name": "VERSION",
                    "value": "docker"
                  },
                  {
                    "name": "ADVERTISE_IP",
                    "value": "http://192.168.1.7:32400/"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/config"
                  },
                  {
                    "name": "media",
                    "mountPath": "/data/media",
                    "readOnly": true
                  },
                  {
                    "name": "downloads",
                    "mountPath": "/data/downloads"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "200m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "4",
                    "memory": "4Gi"
                  }
                },
                "startupProbe": {
                  "tcpSocket": {
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": "http"
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": "http"
                  },
                  "periodSeconds": 30,
                  "failureThreshold": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "persistentVolumeClaim": {
                  "claimName": "plex-config"
                }
              },
              {
                "name": "media",
                "persistentVolumeClaim": {
                  "claimName": "media-library"
                }
              },
              {
                "name": "downloads",
                "persistentVolumeClaim": {
                  "claimName": "downloads"
                }
              }
            ]
          }
        }
      }
